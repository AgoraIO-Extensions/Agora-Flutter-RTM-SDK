# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
build/

.plugin_dev
.fvm
.vscode
.fvmrc
artifacts/

# Test applications and generators are not part of the published Dart SDK.
/test_shard/
/scripts/testcase_gen/
**/node_modules/
**/.terra/
